# Discord -> Grok Bot listener config. Copy to .env (install.ps1 does this) and fill in
# the "changeme" values and the YOUR_... IDs. Never share or commit .env.

# Secrets (required)
DISCORD_BOT_TOKEN=changeme
GROK_BOT_GROK_WEBHOOK_KEY=changeme

# Grok Bot routine webhook (https only)
GROK_BOT_GROK_WEBHOOK_URL=changeme

# Allowlists (Discord IDs, comma-separated). Empty = the listener refuses to start.
DISCORD_GUILD_ALLOWLIST=YOUR_GUILD_ID
DISCORD_CHANNEL_ALLOWLIST=YOUR_CHANNEL_ID
DISCORD_AUTHOR_ALLOWLIST=YOUR_DISCORD_USER_ID

# Behaviour
REQUIRE_MENTION=false
DEBOUNCE_SECONDS=3
IN_FLIGHT_TIMEOUT_SECONDS=300
HISTORY_LIMIT=12
HISTORY_CHAR_CAP=3000
HISTORY_ENTRY_CHAR_CAP=600
TEXT_CHAR_CAP=4000
CATCHUP_LIMIT=100
DRY_RUN=false

# Optional paths (default: data\ and logs\ next to this file)
# DATA_DIR=
# LOG_FILE=
