# Non-secret bridge config (outside git). Real env vars override these.
# Fill the three allowlists with Discord snowflake IDs (comma-separated). Empty = bridge refuses to start.
DISCORD_GUILD_ALLOWLIST=YOUR_GUILD_ID
DISCORD_CHANNEL_ALLOWLIST=YOUR_CHANNEL_ID
# Your own Discord user ID only (owner-only):
DISCORD_AUTHOR_ALLOWLIST=YOUR_DISCORD_USER_ID
REQUIRE_MENTION=false
DEFAULT_BOT=grok
BOTS_FILE=/home/YOU/.config/discord-bridge/bots.yaml
CALLBACK_BIND=127.0.0.1
CALLBACK_PORT=8787
CALLBACK_PUBLIC_URL=http://127.0.0.1:8787
DRY_RUN=false
# Secrets are NOT stored here. Provide via env, or via the *_FILE paths (chmod 600):
#   DISCORD_BOT_TOKEN        or $CFG/secrets/discord_bot_token
#   CALLBACK_SECRET          or $CFG/secrets/callback_secret   (generated locally)
#   GROK_BOT_GROK_WEBHOOK_URL or $CFG/secrets/grok_webhook_url
#   GROK_BOT_GROK_WEBHOOK_KEY or $CFG/secrets/grok_webhook_key
